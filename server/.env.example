# ---------------------------------------------------------------------------
# Backend environment (copy this file to server/.env)
# ---------------------------------------------------------------------------

# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Secret used to sign JWTs. REQUIRED - the API refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Any user logging in with this email is treated as an admin (role escalation
# happens at login). Leave empty to disable.
ADMIN_EMAIL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Public origin used to build URLs for uploaded files. Inside Docker this must
# be the host-visible address (e.g. http://localhost:3001), not the service name.
PUBLIC_BASE_URL=http://localhost:3001

# --- Database (local PostgreSQL) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=service_connect
PG_USER=postgres
PG_PASSWORD=postgres

# Alternative: one connection string instead of the PG_* values above.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_connect

# --- Email (optional) ---
# Without these values the API still works; registration/password-reset codes
# are returned in the HTTP response when NODE_ENV is not "production".
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_SENDER_NAME=Service Connect

# --- Uploads ---
# Defaults to <server>/uploads when empty.
UPLOAD_DIR=

# --- Migrations ---
# Set to false to skip db/seed.sql when running `npm run migrate`.
SEED=true
