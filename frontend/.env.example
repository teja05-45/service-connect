# ---------------------------------------------------------------------------
# Frontend environment (copy this file to frontend/.env)
# ---------------------------------------------------------------------------
# Base URL of the backend API. This value is compiled into the bundle by
# Create React App, so changing it requires a restart (local) or a rebuild
# (Docker Compose: `docker compose up --build`).
#
# It must be reachable FROM THE BROWSER. When running in Docker, use the
# published backend port (http://localhost:3001/api/v1), never the internal
# service name (http://backend:3001/api/v1).
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1
