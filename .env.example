# ---------------------------------------------------------------------------
# Docker Compose environment (copy this file to .env in the repository root)
# Used by docker compose to configure all three containers.
# ---------------------------------------------------------------------------

# --- Database ---
POSTGRES_DB=service_connect
POSTGRES_USER=service_connect
POSTGRES_PASSWORD=change-me-in-production

# Host port for PostgreSQL. Kept off 5432 so it does not clash with a locally
# installed PostgreSQL server.
DB_PORT=5433

# --- Backend ---
JWT_SECRET=change-me-to-a-long-random-secret

# --- Initial administrator (optional, first run only) ---
# When ADMIN_EMAIL and ADMIN_PASSWORD are set AND no administrator exists yet,
# the API creates one on startup. It never overwrites an existing admin and
# never promotes an existing customer/provider account. You can also create it
# explicitly with: cd server && npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
EMAIL_USER=
EMAIL_PASS=
EMAIL_SENDER_NAME=Service Connect

# development keeps the "verification code returned in the response" fallback
# available when SMTP is not configured. Use production for real deployments.
NODE_ENV=development
LOG_LEVEL=info
# Set to false to skip the base service catalogue seed during migration.
SEED=true

BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3001

# --- Frontend ---
FRONTEND_PORT=3000
# Compiled into the bundle at image build time; must be browser-reachable.
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1
